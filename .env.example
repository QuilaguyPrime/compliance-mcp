# Copia a .env y rellena. .env esta en .gitignore y NUNCA se commitea.

# Proveedor primario (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Proveedor de fallback (OpenAI)
OPENAI_API_KEY=sk-...

# Opcional: sobreescribe la ruta del fichero de configuracion
# COMPLIANCE_MCP_CONFIG=config.yaml

# Opcional: nivel de log (DEBUG|INFO|WARNING|ERROR)
# COMPLIANCE_MCP_LOG_LEVEL=INFO
